# ============================================
# CONFIGURATION MYSQL (Module Sauvegarde)
# ============================================
MYSQL_HOST=192.168.10.21
MYSQL_PORT=3306
MYSQL_USER=user1
MYSQL_PASSWORD=Password123!
MYSQL_DATABASE=wms_ntl


# ============================================
# CONFIGURATION DIAGNOSTIC
# ============================================
# Serveurs Active Directory (séparés par des virgules)
AD_SERVERS=192.168.10.10,192.168.10.11
AD_DOMAIN=epsi.local

# Serveurs DNS (séparés par des virgules)
DNS_SERVERS=192.168.10.10,192.168.10.11

# Base de données WMS
WMS_DB_HOST=192.168.10.21
WMS_DB_PORT=3306


# ============================================
# CONFIGURATION SERVEURS 
# ============================================

# ---- Windows Server ----
WIN_HOST=192.168.10.10
WIN_USER=epsi\administrateur
WIN_PASS=Password!

# ---- Serveur Linux ----
LINUX_HOST=192.168.10.21
LINUX_USER=user
LINUX_PASS=password


# ---- Client Linux ----
LINUX_CLIENT=192.168.10.50
LINUX_CLIENT_USER=user
LINUX_CLIENT_PASS=password


# ============================================
# CONFIGURATION AUDIT D'OBSOLESCENCE
# ============================================
SCAN_NETWORKS=192.168.10.0/24,192.168.20.0/24,192.168.30.0/24,192.168.40.0/24
EOL_DATA_SOURCE=https://endoflife.date/api/
SCAN_TIMEOUT=30


# ============================================
# PARAMÈTRES GÉNÉRAUX
# ============================================
OUTPUT_DIR=out
DEBUG=False


